{
    "name": "frontend",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "imports": {
        "#lib": "./src/lib/index.js",
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "yarn build && wrangler dev",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "api": "orval",
        "update-aaguid": "node scripts/updateAaguidList.ts && oxfmt --write src/lib/passkey/aaguid.ts",
        "deploy": "yarn build && wrangler deploy"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@humanspeak/svelte-virtual-list": "^0.5.15",
        "@internationalized/date": "^3.12.4",
        "@simplewebauthn/browser": "^14.0.0",
        "@tabler/icons-svelte-runes": "^3.50.0",
        "@tanstack/svelte-query": "^6.3.6",
        "@tanstack/svelte-query-devtools": "^6.3.6",
        "bits-ui": "^2.20.2",
        "date-fns": "^4.4.0",
        "qr": "^0.7.2",
        "ua-parser-js": "^2.0.10"
    },
    "devDependencies": {
        "@sveltejs/adapter-auto": "^8.0.0",
        "@sveltejs/adapter-static": "^4.0.0",
        "@sveltejs/kit": "^3.1.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^26.6.6",
        "@typescript/native": "npm:typescript@7",
        "formsnap": "^2.1.0",
        "orval": "^8.45.0",
        "oxfmt": "^0.75.0",
        "prettier-plugin-svelte": "^4.1.1",
        "sass-embedded": "^1.107.0",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.7",
        "sveltekit-superforms": "^3.0.0",
        "typescript": "~6",
        "vite": "^8.3.5",
        "wrangler": "^4.156.2",
        "zod": "^4.6.7"
    },
    "packageManager": "yarn@4.18.1"
}
