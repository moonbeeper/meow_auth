        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^26.1.0",
        "formsnap": "^2.0.1",
        "orval": "^8.23.0",
        "oxfmt": "^0.58.0",
        "prettier-plugin-svelte": "^4.1.0",
        "sass-embedded": "^1.100.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
