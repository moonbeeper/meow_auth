{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "trailingComma": "none",
    "printWidth": 100,
    "svelte": true,
    "sortImports": true,
    "ignorePatterns": [
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "bun.lock",
        "bun.lockb",
        "/static/"
    ]
}
