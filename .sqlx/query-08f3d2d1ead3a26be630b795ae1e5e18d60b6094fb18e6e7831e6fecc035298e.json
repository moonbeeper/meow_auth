  "query": "insert into\n                user_signups (id, email, created_at, expires_at)\n            values\n                ($1, lower($2), now(), $3)\n            on conflict (email) do update set\n                email = excluded.email,\n                created_at = now(),\n                expires_at = $3\n            returning\n                id,\n                email,\n                created_at,\n                expires_at\n            ",
