{
  "db_name": "PostgreSQL",
  "query": "select\n                al.id,\n                al.user_id,\n                u.name as user_name,\n                al.actor_id,\n                a.name as actor_name,\n                al.action,\n                al.metadata,\n                al.created_at\n            from audit_logs al\n            join users u on u.id = al.user_id\n            join users a on a.id = al.actor_id\n            where al.user_id = $1 and ($2::uuid is null or al.id::uuid > $2) order by created_at asc limit 20+1\n            ",
