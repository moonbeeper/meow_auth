{
  "db_name": "PostgreSQL",
  "query": "select\n                al.id,\n                al.user_id,\n                u.name as user_name,\n                al.actor_id,\n                al.actor_type,\n                coalesce(\n                    a.name,\n                    case when al.actor_type = 'system' then 'System' else 'Unknown' end\n                ) as \"actor_name!\",\n                al.action,\n                al.resource_type,\n                al.resource_id as \"resource_id?: UlidId\",\n                al.changes,\n                al.actor_ip,\n                al.actor_location,\n                al.actor_user_agent,\n                al.created_at\n            from audit_logs al\n            join users u on u.id = al.user_id\n            left join users a on a.id = al.actor_id\n            where al.user_id = $1\n            ",
