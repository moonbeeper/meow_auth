  "query": "select\n                al.id,\n                al.user_id,\n                u.login as user_login,\n                al.actor_id,\n                a.login as actor_login,\n                al.action,\n                al.metadata,\n                al.created_at\n            from audit_logs al\n            join users u on u.id = al.user_id\n            join users a on a.id = al.actor_id\n            where user_id = $1\n            ",
